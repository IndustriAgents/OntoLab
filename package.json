{
  "name": "ontolab",
  "version": "0.1.0-desktop.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": ".desktop/main.cjs",
  "author": "IndustriAgents",
  "repository": {
    "type": "git",
    "url": "https://github.com/IndustriAgents/OntoLab.git"
  },
  "description": "OntoLab — turn documents from any domain into a reviewed knowledge graph: requirements-first ontology induction, evidence-checked extraction, entity resolution, validation and RDF export.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --strictPort",
    "dev:api": "tsx watch server/index.ts --local-docs",
    "build": "vite build && tsx scripts/build-docs.ts",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/mcp/bridge.ts",
    "desktop:build": "tsx scripts/build-desktop.ts",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --dir --publish never",
    "desktop:dist": "npm run desktop:build && electron-builder --publish never",
    "desktop:dmg:preview": "npm run desktop:build && electron-builder --config electron-builder.preview.yml --mac dmg --arm64 --publish never",
    "desktop:test": "npm run desktop:build && tsx scripts/desktop-smoke.ts",
    "desktop:test:mcp": "npm run desktop:build && tsx scripts/local-mcp-smoke.ts",
    "desktop:verify:dmg": "tsx scripts/verify-desktop-dmg.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:excel:e2e": "vite build && tsx scripts/excel-e2e.ts",
    "test:evidence:e2e": "vite build && tsx scripts/evidence-e2e.ts && MOCK_LLM=1 tsx scripts/evidence-smoke.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "eval": "tsx eval/run.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test:neon": "tsx scripts/neon-check.ts",
    "test:postgres": "tsx scripts/neon-check.ts",
    "docs:dev": "npm --prefix website start",
    "docs:build": "npm --prefix website run build",
    "docs:check": "npm --prefix website run check",
    "test:graph-connections": "TEST_GRAPH_DBS=1 GRAPH_CONNECTIONS_ALLOW_PRIVATE=1 vitest run tests/connectionsDocker.test.ts tests/connections.test.ts",
    "predev": "tsx scripts/build-docs.ts --dev",
    "docs:bundle": "tsx scripts/build-docs.ts --dev"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.8",
    "@rdfjs/data-model": "^2.1.1",
    "@rdfjs/dataset": "^2.0.3",
    "@tanstack/react-query": "^5.104.0",
    "@xmldom/xmldom": "0.8.15",
    "ajv": "^8.20.0",
    "cytoscape": "^3.30.2",
    "cytoscape-dagre": "^3.0.0",
    "cytoscape-fcose": "^2.2.0",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "dotenv": "^16.4.7",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.12.0",
    "n3": "^1.21.3",
    "oxigraph": "^0.5.9",
    "parse5": "^8.1.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "rdf-validate-shacl": "^0.6.5",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "sparqljs": "^3.7.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cytoscape": "^3.21.8",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.54",
    "@types/n3": "^1.21.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sparqljs": "^3.1.12",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.2"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.4"
    },
    "app-builder-lib": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.4"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.4"
    },
    "@eslint/config-array": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.4"
    }
  }
}
