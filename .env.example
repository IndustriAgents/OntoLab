# OntoLab — server environment.
# Copy to `.env` and fill the keys for the providers you want to enable.
# Extraction, T-Box generation and Q&A all run on any configured provider.

# ── Networking ──────────────────────────────────────────────────────────────
# Port the API listens on. API_PORT wins over PORT; the Vite dev proxy reads the
# same value, so the two can never disagree.
API_PORT=3000

# Mount prefix when served behind a gateway (e.g. /ontolab). Leave empty to
# serve at the root. The SPA build and the server both read this — they must match.
BASE_PATH=

# Optional API token for programmatic clients (x-api-token).
# If set, the gateway must inject it. Never expose this secret to the browser.
API_TOKEN=

# Local CLI providers (Claude Code, Codex, Antigravity).
# Enabled in local development. Set LOCAL_CLI_ENABLED=1 to enable in a production build.
# Uses the backend operator's official CLI login and account quota. See docs/LOCAL_CLI_PROVIDERS.md.
# LOCAL_CLI_ENABLED=1
# ONTOLAB_CLAUDE_MODELS=sonnet,opus,haiku
# ONTOLAB_CODEX_MODELS=your-model-id
# ONTOLAB_AGY_MODELS=your-model-id

# ── Providers (set at least one) ────────────────────────────────────────────
# Anthropic Claude — also the only provider that can read PDFs as images.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Ollama (local). Set the base URL to enable; leave blank to disable.
OLLAMA_BASE_URL=
OLLAMA_MODELS=llama3.1,qwen2.5,mistral

# ── Limits (optional; sensible defaults shown) ──────────────────────────────
# MAX_BODY_BYTES=16777216        # max JSON request body (16 MB)
# MAX_DOC_CHARS=1500000          # max characters of document text per request
# MAX_FILE_BASE64=31457280       # max base64 size for one PDF/DOCX (30 MB)
# LLM_TIMEOUT_MS=300000          # wall-clock budget per provider call
# MAX_CONCURRENT_LLM=4           # concurrent provider calls per instance
# RATE_LIMIT=30                  # LLM requests per window per client
# RATE_WINDOW_MS=60000           # rate-limit window
# MAX_OUTPUT_TOKENS=16000        # output cap per generation
# MAX_SPARQL_ROWS=1000           # row cap for competency-question results
# SPARQL_TIMEOUT_MS=15000        # budget for a competency-question query

# ── Neon Postgres ──────────────────────────────────────────────────────────
# neon deploy pulls these into .env (or .env.local). Do not commit credentials.
# Runtime uses the pooled URL; npm run db:migrate uses the direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# STORE_MODE=postgres           # automatic when DATABASE_URL is configured
# Initial Postgres-only setup stores documents/caches as bytea. GCS/S3 can
# replace the BlobStore later without changing the extraction pipeline.

# DATA_DIR=.data                 # local development storage / ML model cache
# MOCK_LLM=1                     # offline mock model (tests / demos only)

# ── Pilot limits (optional; defaults shown) ─────────────────────────────────
# MAX_UPLOAD_BYTES=20971520      # 20 MB per document
# MAX_DOCUMENTS_PER_PROJECT=50
# MAX_SOURCES_PER_CORPUS=1000     # corpus originals; versions and prepared variants do not use source slots
# STORAGE_QUOTA_BYTES=10737418240 # 10 GiB per user (originals + extracted text)
# CHUNK_CHARS=12000              # extraction chunk size, split at paragraphs
# MAX_ACTIVE_STEPS=1             # concurrent extraction steps per deployment
# MAX_STEP_ATTEMPTS=3            # retries of a failing step before the run fails
# MAX_GRAPH_NODES=500            # nodes drawn before the graph asks you to narrow it
# QA_DOC_CHARS=200000            # document text sent per clarification round

# ── Retrieval, evidence and parsing (optional; defaults shown) ──────────────
# Embeddings for schema retrieval, passage retrieval, duplicate detection and
# topic clustering: local (small ONNX model, downloaded once), provider (the
# embedding API of OpenAI / Gemini / Ollama), hash (lexical, no model) or off.
# EMBEDDINGS_BACKEND=local
# EMBEDDINGS_PROVIDER=           # openai | gemini | ollama (default: first configured)
# EMBEDDINGS_PROVIDER_MODEL=     # e.g. text-embedding-3-small
# Entailment check of every claim against its quote: local, provider, lexical, off.
# NLI_BACKEND=local
# NLI_REVIEW_THRESHOLD=0.5
# MODEL_CACHE_DIR=.data/models
# Docling sidecar for layout-aware parsing, PPTX/XLSX/images and OCR
# (sidecar/docling). Empty = built-in parsers.
# PARSER_URL=http://localhost:8001
# PARSER_TOKEN=
# CHUNK_OVERLAP=0.12             # share of a chunk repeated in the next one
# PROMPT_STYLE=code              # T-Box in prompts as typed classes (code) or a tree
# SCHEMA_RETRIEVAL_MIN_TERMS=60  # above this, each chunk gets the relevant part of the T-Box
# SCHEMA_TOP_K=24
# Reasoning in validation: auto (DL sidecar when REASONER_URL is set, else the
# in-process OWL 2 RL engine), rl, dl, or off. DL sidecar: sidecar/reasoner.
# REASONER_TIER=auto
# REASONER_URL=http://localhost:8091
# REASONER_TOKEN=
# REASONER_TIMEOUT_MS=60000
# CQ_DUP_THRESHOLD=0.9           # two competency questions this similar ask the same thing

# ── Scale and cost (optional) ───────────────────────────────────────────────
# WORKER=1                       # advance runs on the server without an open tab
# PARALLEL_STEPS=1               # chunk steps one advance may run concurrently
# RELEVANCE_THRESHOLD=0.12       # skip chunks less related to the ontology (0 = off)
# PRICING_JSON={"my-model":{"input":1,"output":4}}   # USD per million tokens

# ── Graph connections and the assistant ─────────────────────────────────────
# Settings → Graph connections supports GraphDB, Fuseki, RDF4J, generic SPARQL
# and Neo4j's HTTP Query API. See website/docs/guides/graph-connections.md.
# Required in hosted mode before saving credentials; retain in a secret manager.
# Generate once: openssl rand -base64 32
# GRAPH_CONNECTIONS_KEY=
# Trusted self-hosted servers only. Local/disabled-auth mode permits private DBs.
# GRAPH_CONNECTIONS_ALLOW_PRIVATE=1
# MAX_TOOL_ROUNDS=12
# Legacy server-wide GraphDB configuration (local/desktop installations only):
# GRAPHDB_URL=http://localhost:7200
# GRAPHDB_AUTH=user:password
# GRAPHDB_MCP_URL=http://localhost:7200/mcp
# GRAPHDB_WORKBENCH_URL=

# ── External vocabularies and registries (optional) ─────────────────────────
# REUSE_SOURCES=lov,schemaorg    # add bioportal with BIOPORTAL_API_KEY
# BIOPORTAL_API_KEY=
# GEONAMES_USERNAME=             # enables GeoNames grounding
# UMLS_API_KEY=                  # enables UMLS grounding
