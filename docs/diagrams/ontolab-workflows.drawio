<mxfile host="drawio" agent="OntoLab README diagrams"><diagram id="ontolab-workflows" name="ontolab-workflows"><mxGraphModel dx="1600" dy="960" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" background="#f8f7f3" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;span style=&quot;font-family:JetBrains Mono,SFMono-Regular,Menlo,monospace;font-size:14px;letter-spacing:2px;color:#2d6a4b&quot;&gt;HOW ONTOLAB WORKS&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#292a26;" vertex="1" parent="1"><mxGeometry x="64" y="46" width="900" height="20" as="geometry"/></mxCell><mxCell id="t2" value="&lt;span style=&quot;font-family:Georgia,Times New Roman,serif;font-size:38px;color:#292a26&quot;&gt;Every fact keeps a line back to its source.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#292a26;" vertex="1" parent="1"><mxGeometry x="64" y="72" width="1472" height="50" as="geometry"/></mxCell><mxCell id="t3" value="&lt;span style=&quot;font-size:19px;line-height:1.45;color:#5d6057&quot;&gt;Documents pass through your ontology. What comes out is a typed knowledge graph you can trace word for word.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#292a26;" vertex="1" parent="1"><mxGeometry x="64" y="128" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#f1f0ea;strokeColor=#e4e2da;strokeWidth=1.2;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#292a26;verticalAlign=top;align=left;spacing=0;rotation=-5;" vertex=